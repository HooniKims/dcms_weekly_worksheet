rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function contributor() {
      return admin()
        || (signedIn()
          && request.auth.token.role == 'contributor'
          && request.auth.token.sessionVersion is int
          && get(/databases/$(database)/documents/settingsPrivate/security).data.sessionVersion is int
          && request.auth.token.sessionVersion == get(/databases/$(database)/documents/settingsPrivate/security).data.sessionVersion);
    }
    function maxSearchablePlainTextSize() { return 8000; }
    function maxHtmlContentSize() { return 200000; }
    function activeWeek(weekId) {
      return exists(/databases/$(database)/documents/weeks/$(weekId))
        && get(/databases/$(database)/documents/weeks/$(weekId)).data.get('archivedAt', null) == null;
    }
    function validEntry() {
      return request.resource.data.keys().hasOnly(['departmentId', 'htmlContent', 'plainText', 'version', 'updatedAt', 'updatedByRole'])
        && request.resource.data.departmentId == request.resource.id
        && request.resource.data.htmlContent is string
        && request.resource.data.htmlContent.size() <= maxHtmlContentSize()
        && request.resource.data.plainText is string
        && request.resource.data.plainText.size() <= maxSearchablePlainTextSize()
        && request.resource.data.version is int
        && request.resource.data.updatedByRole in ['contributor', 'admin'];
    }

    match /settings/{document} {
      allow read: if contributor();
      allow write: if admin();
    }
    match /settingsPrivate/{document} {
      allow read, write: if false;
    }
    match /departments/{departmentId} {
      allow read: if contributor();
      allow write: if admin();
    }
    match /weeks/{weekId} {
      allow read: if contributor();
      allow create: if admin() && request.resource.data.get('archivedAt', null) == null;
      allow update: if admin()
        && resource.data.get('archivedAt', null) == null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archivedAt']);
      allow delete: if false;
      match /entries/{departmentId} {
        allow read: if contributor();
        allow create: if contributor() && activeWeek(weekId) && validEntry() && request.resource.data.version == 1;
        allow update: if contributor() && activeWeek(weekId) && validEntry() && request.resource.data.version == resource.data.version + 1;
        allow delete: if admin() && activeWeek(weekId);
        match /revisions/{version} {
          allow read: if admin();
          allow write: if false;
        }
      }
    }
    match /adminProfiles/{uid} {
      allow read, write: if admin();
    }
    match /searchIndex/{recordId} {
      allow read: if contributor();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
