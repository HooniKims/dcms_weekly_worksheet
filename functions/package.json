{
  "name": "weekly-work-progress-functions",
  "private": true,
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check src",
    "serve": "bun run build && firebase emulators:start --only functions,firestore,auth",
    "seed": "bun run build && node lib/seed.js",
    "seed:rest": "bun run build && node lib/seedRest.js",
    "migrate": "bun run build && node lib/migrate.js"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "typescript": "^5.9.2"
  }
}
